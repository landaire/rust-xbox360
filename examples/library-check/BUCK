load("//buck:xex.bzl", "xbox360_title")

xbox360_title(
    name = "library-check",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    edition = "2024",
    link_script = "link.x",
    manifest = "xex.toml",
    # Condition register bits in general-purpose registers: LLVM then
    # emits no `mcrf`, which Xenia does not implement, in this crate.
    rustc_flags = ["-Ctarget-feature=-crbits"],
    deps = ["//crates/xbox360:xbox360-alloc"],
)
