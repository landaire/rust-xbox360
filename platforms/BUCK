load("//buck:platforms.bzl", "sysroot_build_transition")

# Host targets use the detected host platform. Xbox targets enter the
# configuration through the transitions in buck/platforms.bzl.
constraint(
    name = "target",
    default = "host",
    values = [
        "host",
        "xbox",
    ],
    visibility = ["PUBLIC"],
)

constraint(
    name = "codegen",
    default = "ppc32",
    values = [
        "ppc32",
        "ppc64-ilp32",
    ],
    visibility = ["PUBLIC"],
)

config_setting(
    name = "xbox-ppc64-ilp32",
    constraint_values = [
        ":codegen[ppc64-ilp32]",
        ":target[xbox]",
    ],
    visibility = ["PUBLIC"],
)

constraint(
    name = "mode",
    default = "dev",
    values = [
        "dev",
        "release",
        "release-no-symbols",
    ],
    visibility = ["PUBLIC"],
)

# Which standard library crates the Rust toolchain provides to a crate:
# none while building those crates themselves, core and alloc for
# no_std titles, or std.
constraint_setting(
    name = "sysroot",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "sysroot-none",
    constraint_setting = ":sysroot",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "sysroot-core",
    constraint_setting = ":sysroot",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "sysroot-std",
    constraint_setting = ":sysroot",
    visibility = ["PUBLIC"],
)

# The standard library of system modules: its threads start in the system
# process and its sockets open as the system.
constraint_value(
    name = "sysroot-std-system",
    constraint_setting = ":sysroot",
    visibility = ["PUBLIC"],
)

# For building targets directly, for example
# `buck2 build xbox360//sysroot:std --target-platforms xbox360//platforms:xbox360-std`.
# Titles do not need them; xbox360_title applies the same constraints.
platform(
    name = "xbox360-core",
    constraint_values = [
        ":sysroot-core",
        ":target[xbox]",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "xbox360-std",
    constraint_values = [
        ":sysroot-std",
        ":target[xbox]",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "xbox360-std-system",
    constraint_values = [
        ":sysroot-std-system",
        ":target[xbox]",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "xbox360-sysroot",
    constraint_values = [
        ":sysroot-none",
        ":target[xbox]",
    ],
    visibility = ["PUBLIC"],
)

# Experimental configurations that use 64-bit integer registers with the
# console's 32-bit pointers and ABI.
platform(
    name = "xbox360-ppc64-ilp32-core",
    constraint_values = [
        ":codegen[ppc64-ilp32]",
        ":sysroot-core",
        ":target[xbox]",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "xbox360-ppc64-ilp32-std",
    constraint_values = [
        ":codegen[ppc64-ilp32]",
        ":sysroot-std",
        ":target[xbox]",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "xbox360-ppc64-ilp32-std-system",
    constraint_values = [
        ":codegen[ppc64-ilp32]",
        ":sysroot-std-system",
        ":target[xbox]",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "xbox360-ppc64-ilp32-sysroot",
    constraint_values = [
        ":codegen[ppc64-ilp32]",
        ":sysroot-none",
        ":target[xbox]",
    ],
    visibility = ["PUBLIC"],
)

sysroot_build_transition(
    name = "sysroot-build-transition",
    sysroot_none = ":sysroot-none",
    visibility = ["PUBLIC"],
)
